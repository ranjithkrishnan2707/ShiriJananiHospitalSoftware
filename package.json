{
  "name": "janani-hospital-software",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "desktop": "electron .",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder --win",
    "pack": "electron-builder --dir",
    "test": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.janani.hospitalssoftware",
    "productName": "Shree Janani Hospital Software",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "forceCodeSigning": false
    },
    "portable": {
      "artifactName": "${productName}.exe"
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.24.0",
    "mysql2": "^3.23.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
